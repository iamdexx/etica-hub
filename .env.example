# Chain RPCs
ETICA_MAINNET_RPC_URL=https://rpc2.etica-stats.org
ETICA_CRUCIBLE_RPC_URL=http://173.212.202.226:8545

# Treasury / admin wallet (owner of factory, fee recipient, contract owner)
TREASURY_ADDRESS=0xB2B4bC9d02970A55efF64C2D84c622c87967C19D

# Deployer private key (testnet-only; never commit mainnet keys)
DEPLOYER_PRIVATE_KEY=

# Contract verification: eticascan.org does not currently expose a verify API
# (the /verifyContract page is an unimplemented placeholder and Sourcify does
# not support chainId 61803). Contracts are verified via
# `apps/web/scripts/verify-contract.mjs`, which writes manifests to
# `apps/web/public/verified/<address>.json`. No API key required.

# IPFS gateway (for Research Hub)
IPFS_GATEWAY_URL=https://ipfs.io/ipfs/

# Indexer database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/etica_hub

# Telegram buy bot (/api/cron/buybot)
# Create a bot with @BotFather and copy the HTTP token here.
BUYBOT_TELEGRAM_BOT_TOKEN=
# Channel/group chat id (numeric, usually negative for channels).
BUYBOT_TELEGRAM_CHAT_ID=
# Optional: bot-only RPC override; falls back to ETICA_MAINNET_RPC_URL.
BUYBOT_RPC_URL=
# Explorer base URL used to build per-tx links inside the bot message.
BUYBOT_EXPLORER_BASE_URL=https://eticahub.com
# Drop swaps below this USD value to keep the channel clean. Set to 0 to post all.
BUYBOT_MIN_USD_TO_POST=0.1
# BlockScout explorer base URL used to read native EGAZ supply for accurate
# WEGAZ market-cap reporting (the WEGAZ ERC-20 only counts the wrapped slice).
BUYBOT_ETICA_STATS_EXPLORER_URL=http://explorer.etica-stats.org
# Upstash / Vercel KV cursor storage for `lastScannedBlock`. Required in prod.
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Etica AI Telegram bot (/api/telegram/webhook).
# See docs/AIBOT_SETUP.md for the BotFather + webhook registration runbook.
# The bot only responds when @-mentioned or replied to, and only in
# allowlisted chats. Works as either an admin or non-admin group member.
AIBOT_TELEGRAM_BOT_TOKEN=
# Comma-separated chat ids the bot may answer in (numeric, usually negative
# for groups, e.g. -1001234567890). Empty disables the bot.
AIBOT_ALLOWED_CHAT_IDS=
# Long random string passed to Telegram via setWebhook?secret_token=...
# Telegram echoes it back in the X-Telegram-Bot-Api-Secret-Token header on
# every webhook call; we reject any call missing/mismatching this value.
AIBOT_WEBHOOK_SECRET_TOKEN=
# Optional: bot @username (without the leading @). Auto-discovered via
# getMe if unset.
AIBOT_USERNAME=
# Max LLM-backed replies per chat per UTC day. 0 = unlimited.
AIBOT_CHAT_DAILY_CAP=1000
# Hard daily USD ceiling across all chats. 0 = unlimited. With the
# default Gemini + Groq free chain the per-call cost is $0, so this
# only matters when a paid provider is appended.
AIBOT_DAILY_USD_CAP=5

# LLM provider chain. Comma-separated, in priority order — the first
# provider that returns a non-error response wins; later providers are
# skipped. Default: gemini,groq (both free, no card). Append `,openai`
# for paid fallback.
AIBOT_LLM_PROVIDERS=gemini,groq
# Provider API keys. Each provider's env vars follow the pattern
# AIBOT_LLM_<ID>_API_KEY / _BASE_URL / _MODEL / _INPUT_PRICE_USD_PER_M /
# _OUTPUT_PRICE_USD_PER_M. Sensible defaults are baked in for `gemini`,
# `groq`, `openai`, `mistral`, `openrouter` — only API_KEY is required
# for those.
AIBOT_LLM_GEMINI_API_KEY=
AIBOT_LLM_GROQ_API_KEY=
AIBOT_LLM_OPENAI_API_KEY=
# KV / Redis for daily-cap counters. Either KV REST (Vercel KV /
# Upstash REST) OR a TCP redis url. KV REST takes precedence when both
# are set. The legacy `KV_REST_API_*` and `REDIS_URL` env vars are
# accepted as fallbacks so the bot picks up the same backend the
# buybot already uses.
AIBOT_KV_REST_URL=
AIBOT_KV_REST_TOKEN=
AIBOT_REDIS_URL=
# KV key namespace (default `aibot:prod`).
AIBOT_KV_NAMESPACE=aibot:prod
# Optional: override the base URL the bot reads `/api/v1/*` from. By
# default we use the request's own origin in production and
# https://$VERCEL_URL otherwise.
AIBOT_API_BASE_URL=

# Aggregator backlinks (footer on every page). Empty => link hidden.
# Flip these after the respective listing is approved.
# CoinGecko coin id slug, e.g. `eticahub` — whatever CoinGecko assigns at approval.
NEXT_PUBLIC_COINGECKO_COIN_ID=
# CoinMarketCap currency slug, e.g. `etica-hub` (the URL segment after /currencies/).
NEXT_PUBLIC_CMC_SLUG=
# DEX Screener pair address (checksummed), e.g. 0x7009DED3686b61fa3ae2c5E5cEe56042BefEBE68.
NEXT_PUBLIC_DEXSCREENER_PAIR=
# GeckoTerminal pool address (checksummed), e.g. 0x7009DED3686b61fa3ae2c5E5cEe56042BefEBE68.
NEXT_PUBLIC_GECKOTERMINAL_POOL=

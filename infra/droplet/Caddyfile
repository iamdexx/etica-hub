# SITE_ADDRESS=:80 serves plain HTTP on the droplet IP; set it to a hostname
# (e.g. eticascan.eticahub.com) once DNS points here and Caddy issues TLS itself.
{$SITE_ADDRESS::80} {
	encode gzip
	handle /api/* {
		reverse_proxy engine:6633
	}
	# Etherscan-compatible API + indexer health (apps/explorer-api): /hub/api?module=account&action=txlist&address=0x…
	handle_path /hub/* {
		reverse_proxy explorer-api:6634
	}
	handle {
		reverse_proxy eticascan:3000
	}
}

# Public archive RPC for Etica (core-geth, /opt/etica-node). TLS is automatic.
rpc.eticahub.com {
	encode gzip
	@ws header Connection *Upgrade*
	handle @ws {
		reverse_proxy etica-archive:8546
	}
	handle /graphql* {
		reverse_proxy etica-archive:8545
	}
	handle {
		reverse_proxy etica-archive:8545
	}
}

pool.eticahub.com {
    encode gzip
    header Access-Control-Allow-Origin "*"
    header Access-Control-Allow-Methods "GET, OPTIONS"
    @options method OPTIONS
    respond @options 204
    # Read-only stats only; the pool API also has POST /api/settings and /api/mining which must not be public.
    @stats {
        method GET
        path /api/stats /api/blocks /api/payments /api/miners /api/finders /api/accounts/*
    }
    handle @stats {
        reverse_proxy etica-pool-api:8080
    }
    handle /api/* {
        respond 404
    }
    handle {
        redir https://eticahub.com/mine 302
    }
}

etipool.eticahub.com {
    encode gzip
    header /api/* >Access-Control-Allow-Origin "*"
    header /api/* >Access-Control-Allow-Methods "GET, OPTIONS"
    # ETI (RandomX) pool web UI + stats API; stratum ports 3333/5555/7777/9999 are plain TCP, not proxied.
    handle /socket.io/* {
        reverse_proxy eti-pool-app:2053
    }
    # The pool API has unauthenticated POST handlers (/api/v1/poolinfo writes pool records); only GET is public.
    @api_write {
        path /api/*
        not method GET HEAD OPTIONS
    }
    handle @api_write {
        respond 405
    }
    handle {
        reverse_proxy eti-pool-app:8080
    }
}

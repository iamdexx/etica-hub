# Copy to .env on the droplet. Never commit .env.
PG_PASSWORD=change-me
# Public Etica RPC the engine indexes from (any node works; run your own for full trust).
ETICA_RPC_URL=https://eticamainnet.eticaprotocol.org
# How far behind head a fresh database starts indexing.
SEED_LOOKBACK_BLOCKS=5000
# :80 = plain HTTP on the droplet IP. A hostname here turns on automatic HTTPS.
SITE_ADDRESS=:80
# Watchdog (watchdog.sh, cron every 5 min): extra RPCs to read the chain head from,
# Telegram alert target when the indexer lags, and days of nightly pg_dumps to keep.
ETICA_RPC_URLS=https://eticamainnet.eticaprotocol.org,https://61803.rpc.thirdweb.com,https://eticamainnet.eticascan.org
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=
BACKUP_KEEP=7

# Copy to .env on the agent host. Never commit .env.

# Validator signing key (hex, 0x-prefixed). Signs mailbox checkpoints on both
# chains; must match the `validators:` entry in core-config / warp-usdc. Needs a
# little gas on both chains for the one-time on-chain announcement
# (~0.005 ETH, ~1 EGAZ).
VALIDATOR_KEY=

# Relayer key. Pays destination gas for every delivery: keep ~0.1 ETH on
# Ethereum (redemptions) and ~50 EGAZ on Etica (mints) topped up. Distinct
# from VALIDATOR_KEY and from any contract owner.
RELAYER_KEY=
# Public address of RELAYER_KEY (healthcheck.sh uses it for the gas probe).
RELAYER_ADDRESS=

# Comma-separated RPC URLs. Keyless public endpoints work: the relayer fails
# over down the list and indexes logs in ETHEREUM_INDEX_CHUNK-block chunks
# (public nodes cap eth_getLogs ranges; 100 fits every endpoint below), the
# validators run them in quorum (VALIDATOR_RPC_CONSENSUS) so no single
# endpoint can feed a validator a fake lock event to sign. Keep >= 3
# independent Ethereum operators in the list for that to mean anything; a
# paid URL can go first if you have one. Under heavy throttling deliveries
# are retried later, not lost.
ETHEREUM_RPC_URLS=https://gateway.tenderly.co/public/mainnet,https://rpc.mevblocker.io,https://eth.drpc.org,https://ethereum-rpc.publicnode.com
ETICA_RPC_URLS=https://eticamainnet.eticaprotocol.org,https://rpc2.etica-stats.org,https://eticamainnet.eticascan.org
# quorum = validators sign only what the endpoints agree on; fallback = trust
# the first endpoint that answers (only for a single paid provider you trust).
VALIDATOR_RPC_CONSENSUS=quorum
ETHEREUM_INDEX_CHUNK=100

# Restrict the relayer to the USDC warp route. Fill from
# registry/deployments/warp_routes/USDC/etica-config.yaml after `deploy.sh warp`.
RELAYER_WHITELIST=[{"originDomain":1,"senderAddress":"<ETH_ROUTER>","destinationDomain":61803,"recipientAddress":"<ETICA_ROUTER>"},{"originDomain":61803,"senderAddress":"<ETICA_ROUTER>","destinationDomain":1,"recipientAddress":"<ETH_ROUTER>"}]

# healthcheck.sh alerting (same bot/chat as the other EticaHub ops alerts).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Alert when the relayer's wallet drops below these (whole units).
# Below these the relayer is not being refilled fast enough by the bridge-gas
# keeper (.github/workflows/bridge-gas.yml), which swaps accrued USDC fees to gas.
MIN_RELAYER_ETH=0.03
MIN_RELAYER_EGAZ=10

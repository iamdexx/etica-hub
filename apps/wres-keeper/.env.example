# ─────────────────────────────────────────────────────────────────────────────
# wRES keeper — environment configuration
#
# The keeper is the only cross-chain actor in the wRES product. It watches the
# Etica RESLockVault for new locks, mints/​fronts twins on TRON, routes energy
# revenue, and pays ETX to holders' Etica wallets. It custodies no user
# principal — every contract is drain-proof independent of keeper honesty.
#
# Leave keys unset to run in DRY-RUN mode (reads + logs intended writes, never
# broadcasts). This file documents every variable; copy it to `.env` and fill in.
# ─────────────────────────────────────────────────────────────────────────────

# ── Etica (L1) ───────────────────────────────────────────────────────────────
# RPC endpoint + chain id for the Etica side (RESLockVault, ETRX, ETX DEX).
WRES_ETICA_RPC_URL=https://rpc2.etica-stats.org
WRES_ETICA_CHAIN_ID=61803

# RESLockVault — emits Locked(resTokenId, owner, tronRecipient, payoutWallet).
# REQUIRED to watch entries; if unset the entry watcher is disabled.
WRES_RES_LOCK_VAULT_ADDRESS=

# ETRX — 1:1-backed bridged TRX on Etica. Optional; needed for the payout leg.
WRES_ETRX_ADDRESS=

# ETX token + DEX router on Etica. Optional; needed to swap eTRX -> ETX.
WRES_ETX_ADDRESS=
WRES_DEX_ROUTER_ADDRESS=

# ── TRON ─────────────────────────────────────────────────────────────────────
# TRON full-node HTTP endpoint. Mainnet: https://api.trongrid.io
# Nile testnet: https://nile.trongrid.io ; Shasta: https://api.shasta.trongrid.io
WRES_TRON_RPC_URL=https://api.trongrid.io

# WrappedRESMiner (ERC-721 twin) + TrxReserve (TRX float) on TRON.
# Base58 (T...) or 0x41 hex. WRAPPED_RES_MINER is REQUIRED for TRON ops.
WRES_WRAPPED_RES_MINER_ADDRESS=
WRES_TRX_RESERVE_ADDRESS=

# ── Signers ──────────────────────────────────────────────────────────────────
# 0x-prefixed private keys. If BOTH are unset the keeper forces DRY-RUN.
# TRON key  -> signs mintTwin / frontUpgrade / claimForPayout / topUp.
# Etica key -> signs keeperUnlock / ETRX.mint / swap / ETX transfer.
WRES_KEEPER_TRON_PRIVATE_KEY=
WRES_KEEPER_ETICA_PRIVATE_KEY=

# ── Economic policy (mirrors on-chain constants) ─────────────────────────────
# Initial TRX fronted from the reserve into each new twin (0 = don't auto-front).
WRES_INITIAL_FRONT_TRX=0
# Minimum settled TRX before a twin is paid out (avoids dust payouts).
WRES_MIN_PAYOUT_TRX=1
# Revenue slice retained in the TRX reserve before ETX buyback. 100 bps = 1%.
WRES_RESERVE_TOPUP_BPS=100
# Revenue slice retained by the keeper for its own gas/energy. 100 bps = 1%.
# The keeper keeps this TRX in its wallet — no tx needed. Self-funding.
WRES_KEEPER_OPS_BPS=100
# Max tolerated slippage on the eTRX -> ETX swap. 100 bps = 1%.
WRES_MAX_SLIPPAGE_BPS=100
# Per-transaction fee ceiling for TRON sends, in SUN. Default 150 TRX.
WRES_TRON_FEE_LIMIT_SUN=150000000

# ── Loop / scanning ──────────────────────────────────────────────────────────
WRES_SCAN_LOOKBACK_BLOCKS=5000
WRES_POLL_INTERVAL_MS=60000
# Force dry-run regardless of keys (true|false). Defaults to true when no keys set.
WRES_DRY_RUN=

# ── Alerts (optional) ────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

{
  "name": "@etica-hub/keeper",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "dry-run": "tsx src/dry-run.ts",
    "harvest:dry-run": "tsx src/harvest/dry-run.ts",
    "harvest:live": "tsx src/harvest/run-live.ts",
    "forfeit:dry-run": "tsx src/forfeit/dry-run.ts",
    "forfeit:live": "tsx src/forfeit/run-live.ts",
    "bridge-gas:dry-run": "tsx src/bridge-gas/dry-run.ts",
    "bridge-gas:live": "tsx src/bridge-gas/run-live.ts",
    "bridge-seed:dry-run": "tsx src/bridge-seed/dry-run.ts",
    "bridge-seed:live": "tsx src/bridge-seed/run-live.ts",
    "marketplace:deploy": "tsx src/marketplace/deploy.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "echo 'no lint'",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@etica-hub/shared": "workspace:*",
    "dotenv": "^16.4.5",
    "viem": "^2.21.44"
  },
  "devDependencies": {
    "@types/node": "^20.17.6",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}

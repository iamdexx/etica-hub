{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd ../.. && pnpm --filter @etica-hub/web... build",
  "installCommand": "cd ../.. && pnpm install --frozen-lockfile",
  "ignoreCommand": "cd ../.. && git diff --quiet HEAD^ HEAD -- apps/web packages/shared package.json pnpm-lock.yaml pnpm-workspace.yaml",
  "crons": [
    {
      "path": "/api/cron/buybot",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/telemetry",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/labs/autopilot/dispatch",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/labs/fold/retry",
      "schedule": "*/5 * * * *"
    }
  ]
}

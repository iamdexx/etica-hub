# Hyperlane-on-Etica deploy + validator/relayer bundle.
#
# Copy this file to `.env` and fill in. Do NOT commit `.env` — it's
# gitignored. Provisioning scripts read from `.env`; runtime daemons
# read from generated `validator.env` + `relayer.env` in the deploy
# directory on the VPS.

# ─── Provisioning credentials ──────────────────────────────────────

# Hetzner Cloud API token (Read & Write).
# https://console.hetzner.cloud/projects → Security → API Tokens.
HETZNER_API_TOKEN=

# Cloudflare account ID + R2 API token.
# https://dash.cloudflare.com/?to=/:account/r2/api-tokens
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Cloudflare R2 S3-compatible credentials. Auto-populated by
# scripts/setup-r2.sh; leave blank on first run.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=etica-hyperlane-validator-signatures
R2_REGION=auto
R2_ENDPOINT_URL=

# ─── On-chain deploy credentials ───────────────────────────────────

# Burner hex key (0x-prefixed) funded with ≥10 EGAZ on Etica.
# Used ONLY for `hyperlane core deploy`. Retired immediately after.
ETICA_HYPERLANE_DEPLOYER_KEY=

# Owner of the deployed Hyperlane contracts (hardware wallet / multisig).
# Public 0x… address only — NOT a private key.
BRIDGE_OWNER_ADDRESS=

# ─── Validator + relayer signing keys ──────────────────────────────

# Validator signing key. Fresh EOA — does NOT need to be funded.
# Auto-generated by scripts/install-on-vps.sh if blank.
HYP_VALIDATOR_KEY=

# Validator signer key for `validatorAnnounce` tx on Etica. Funded
# with ~0.1 EGAZ. Defaults to ETICA_HYPERLANE_DEPLOYER_KEY if blank
# (the deployer key still has gas at announce time).
HYP_VALIDATOR_TX_KEY=

# Relayer signing key. Single EOA, funded on all 3 chains.
# Auto-generated by scripts/install-on-vps.sh if blank.
HYP_RELAYER_KEY=

# ─── Chain RPC URLs ────────────────────────────────────────────────

ETICA_RPC_URL=https://eticamainnet.eticascan.org
ETHEREUM_RPC_URL=https://ethereum-rpc.publicnode.com
BSC_RPC_URL=https://bsc-rpc.publicnode.com

# ─── VPS connection (auto-populated by provision-hetzner.sh) ───────

VPS_IP=
VPS_HOSTNAME=etica-hyperlane.local
VPS_SSH_KEY_PATH=~/.ssh/etica-hyperlane-validator

# ─── Optional: alerting (reuses bridge-watcher Telegram) ───────────

BRIDGE_TELEGRAM_BOT_TOKEN=
BRIDGE_TELEGRAM_CHAT_ID=

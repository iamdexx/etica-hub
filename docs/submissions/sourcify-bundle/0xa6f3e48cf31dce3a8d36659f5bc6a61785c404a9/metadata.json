type":"uint16"},{"internalType":"uint16","name":"totalInBatch","type":"uint16"},{"internalType":"bytes32","name":"batchId","type":"bytes32"},{"internalType":"uint256","name":"triggerPrice","type":"uint256"},{"internalType":"uint256","name":"levelPrice","type":"uint256"}],"internalType":"struct OrderRegistry.OrderMeta[]","name":"metas","type":"tuple[]"}],"name":"postOrderBatch","outputs":[{"internalType":"bytes32[]","name":"orderHashes","type":"bytes32[]"}],"stateMutability":"nonpayable","type":"function"}],"devdoc":{"kind":"dev","methods":{"cancelOrder(bytes32)":{"details":"Only callable by the original poster. Does NOT invalidate the      order on-chain (Permit2 still accepts the signature); keepers      honour this flag by refusing to submit, but anyone can still      call the reactor directly if they ignore the registry. For      authoritative cancellation, call Permit2's `invalidateNonces`."},"postOrder(bytes,bytes,(uint8,uint8,uint16,uint16,bytes32,uint256,uint256))":{"params":{"encodedOrder":"The abi-encoded UniswapX DutchOrder bytes.","meta":"Strategy flavor + optional trigger / batch metadata.","signature":"The EIP-712 signature over the order's Permit2 witness."},"returns":{"orderHash":"Canonical `keccak256(encodedOrder)` identifier."}},"postOrderBatch(bytes[],bytes[],(uint8,uint8,uint16,uint16,bytes32,uint256,uint256)[])":{"returns":{"orderHashes":"Canonical hashes for each posted order, in input order."}}},"title":"OrderRegistry","version":1},"userdoc":{"events":{"OrderCancelled(bytes32,address)":{"notice":"Emitted when the original poster flags an order as cancelled."},"OrderPosted(bytes32,address,uint8,bytes,bytes,(uint8,uint8,uint16,uint16,bytes32,uint256,uint256))":{"notice":"Emitted once per newly-posted order. Keepers subscribe to         this event to discover fresh work. The full encodedOrder +         signature are emitted in-band so an indexer-less keeper can         reconstruct everything it needs from the log."}},"kind":"user","methods":{"cancelOrder(bytes32)":{"notice":"Flag an order as cancelled at the registry layer."},"exists(bytes32)":{"notice":"Whether a given order has been posted (regardless of cancellation state)."},"getOrder(bytes32)":{"notice":"Read a stored order. Reverts with {OrderNotFound} if never posted."},"isCancelled(bytes32)":{"notice":"Whether a given order is cancelled. Returns false for unknown / never-posted hashes."},"postOrder(bytes,bytes,(uint8,uint8,uint16,uint16,bytes32,uint256,uint256))":{"notice":"Post a single signed order."},"postOrderBatch(bytes[],bytes[],(uint8,uint8,uint16,uint16,bytes32,uint256,uint256)[])":{"notice":"Post a batch of signed orders in a single transaction. Each         order is independent \u2014 ordering within the batch only affects         gas layout, not execution semantics. Useful for DCA / grid         strategies that pre-sign N orders and want to publish them         atomically."}},"notice":"Permissionless on-chain registry for signed UniswapX orders.         Swappers call {postOrder} (or {postOrderBatch}) to publish signed         DutchOrders on-chain. Keepers discover work by subscribing to         {OrderPosted} logs and submit fills via the reactor in the normal         UniswapX flow; the registry never touches funds and never talks to         Permit2 or the reactor.         The registry is **fully permissionless**: there is no owner, no         pausing, no censorship surface. Anyone can post anything (they pay         gas). Orders with invalid signatures will simply fail at the         reactor when a keeper tries to fill them and are effectively         filtered out by the keeper's simulation step. Registry-level         cancellation is a convenience signal for keepers to skip an order;         the authoritative cancellation is still on-chain nonce         invalidation via Permit2 (or the order's deadline lapsing).         Designed to be trivially upgradeable by redeploying \u2014 keepers         discover the active registry from `DEPLOYMENTS.orderRegistry` in         the frontend, so migration is a single address change.","version":1}},"settings":{"compilationTarget":{"src/OrderRegistry.sol":"OrderRegistry"},"evmVersion":"prague","libraries":{},"metadata":{"bytecodeHash":"ipfs"},"optimizer":{"enabled":true,"runs":1000000},"remappings":[":@openzeppelin/contracts/=lib/uniswapx/lib/calibur/lib/openzeppelin-contracts/contracts/",":FreshCryptoLib/=lib/uniswapx/lib/calibur/lib/webauthn-sol/lib/FreshCryptoLib/solidity/src/",":Tribunal/=lib/uniswapx/lib/Tribunal/src/",":account-abstraction/=lib/uniswapx/lib/calibur/lib/account-abstraction/contracts/",":blocknumberish/=lib/uniswapx/lib/blocknumberish/",":calibur/=lib/uniswapx/lib/calibur/",":ds-test/=lib/uniswapx/lib/forge-std/lib/ds-test/src/",":erc20-eth/=lib/uniswapx/lib/calibur/lib/erc20-eth/src/",":erc4626-tests/=lib/uniswapx/lib/openzeppelin-contracts/lib/erc4626-tests/",":forge-gas-snapshot/=lib/uniswapx/lib/forge-gas-snapshot/src/",":forge-std/=lib/uniswapx/lib/forge-std/src/",":halmos-cheatcodes/=lib/uniswapx/lib/calibur/lib/openzeppelin-contracts/lib/halmos-cheatcodes/src/",":openzeppelin-contracts/contracts/utils/=lib/uniswapx/lib/calibur/lib/openzeppelin-contracts/contracts/utils/",":openzeppelin-contracts/security/=lib/uniswapx/lib/openzeppelin-contracts/contracts/security/",":openzeppelin-contracts/utils/=lib/uniswapx/lib/openzeppelin-contracts/contracts/utils/",":openzeppelin/=lib/uniswapx/lib/openzeppelin-contracts/contracts/",":permit2/=lib/uniswapx/lib/permit2/",":solady/=lib/uniswapx/lib/calibur/lib/solady/src/",":solarray/=lib/uniswapx/lib/solarray/src/",":soledge/=lib/uniswapx/lib/Tribunal/lib/the-compact/lib/soledge/src/",":solmate/=lib/uniswapx/lib/solmate/",":the-compact/=lib/uniswapx/lib/Tribunal/lib/the-compact/",":tribunal/=lib/uniswapx/lib/Tribunal/",":uniswapx/=lib/uniswapx/",":webauthn-sol/=lib/uniswapx/lib/calibur/lib/webauthn-sol/"]},"sources":{"src/OrderRegistry.sol":{"keccak256":"0x618328752b6c3a29bac6a4b3224f38492b4dea55d6d09